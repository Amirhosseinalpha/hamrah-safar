# رونوشت این فایل را با نام .env بسازید
PORT=3000
ADMIN_USER=admin
# رمز قوی انتخاب کنید (حداقل ۸ نویسه). فقط هنگام ساخت اولین مدیر خوانده می‌شود.
ADMIN_PASS=7zvz6KZurMuA
# true فقط وقتی پشت HTTPS هستید
COOKIE_SECURE=false
# پایگاه داده: پیش‌فرض فایل محلی data/hamrah.db است. برای دیتابیس ابری (Turso) این دو را پر کنید:
# DATABASE_URL=libsql://your-db.turso.io
# DATABASE_AUTH_TOKEN=
# پشت Nginx/Caddy true بگذارید تا IP واقعی کاربر برای محدودیت نرخ خوانده شود
TRUST_PROXY=false

# --- پیامک ---
# log = فقط ثبت در سیستم (آزمایشی) | kavenegar = ارسال واقعی
SMS_PROVIDER=log
SMS_API_KEY=
SMS_SENDER=
# --- درگاه پرداخت ---
# sandbox = درگاه آزمایشی داخلی | zarinpal
PAYMENT_GATEWAY=sandbox
ZARINPAL_MERCHANT=
# در حالت production درگاه آزمایشی فقط با true فعال می‌شود
ALLOW_SANDBOX_PAY=false
NODE_ENV=production
